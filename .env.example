# Copy this file to .env and fill it in. Never share or commit .env.

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=paste-your-gemini-key-here

# Signs the login cookie. Make a long random one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If this is missing, everyone is logged out every time the server restarts.
SECRET_KEY=paste-a-long-random-string-here

# Optional: pick another Gemini model
# GEMINI_MODEL=gemini-flash-latest
